# ─────────────────────────────────────────────────────────────────────────────
# ParkingTrade E2E — environment configuration
#
# Copy to e2e/.env and fill in. The suite runs against WHATEVER these point to:
#   • Local stack:  run `supabase start`, then `supabase status` prints the
#     local URL + keys (defaults below work out of the box for local).
#   • Production:   set the project URL + keys from
#     Dashboard → Project Settings → API. The service_role key is REQUIRED
#     (used to create/delete test users via the Auth Admin API).
#
# ⚠️  The service_role key bypasses RLS. Never commit e2e/.env.
# ─────────────────────────────────────────────────────────────────────────────

# Local-stack defaults (from `supabase start`):
E2E_SUPABASE_URL=http://127.0.0.1:54321
E2E_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
E2E_SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# For production, replace with e.g.:
# E2E_SUPABASE_URL=https://njlbcrcoogpblscvjfah.supabase.co
# E2E_SUPABASE_ANON_KEY=<anon key>
# E2E_SUPABASE_SERVICE_ROLE_KEY=<service role key>
